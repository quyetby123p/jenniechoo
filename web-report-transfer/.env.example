# Safe transfer template for the web report only.
# Replace every <...> value on the target machine. This file intentionally
# contains no live access token, password, refresh token, or API key.

APP_TIMEZONE=Asia/Ho_Chi_Minh
APP_CURRENCY=VND
APP_RETRY_MAX=3
APP_RETRY_BACKOFF=2,5,10

# Web report runtime
WEB_REPORT_HOST=0.0.0.0
WEB_REPORT_PORT=8000
WEB_REPORT_REFRESH_SECONDS=600
WEB_REPORT_THAI_DUONG_TIMEOUT_SECONDS=8
WEB_REPORT_STATUS_MAP_PATH=config/web_report_status_map.json
WEB_REPORT_SOURCE_COSTS_PATH=config/web_report_source_costs.json
WEB_REPORT_API_TOKEN=<generate-a-long-random-read-only-token>
REPORT_THB_TO_VND_RATE=750
REPORT_THB_MINOR_UNIT_FACTOR=100

# JC / main profile
META_ACCESS_TOKEN=<jc-meta-access-token>
META_PAGE_ACCESS_TOKEN=<jc-meta-page-access-token>
META_AD_ACCOUNT_ID=<jc-meta-ad-account-id>
META_PAGE_ID=<jc-meta-page-id>
META_API_VERSION=v21.0
PANCAKE_API_BASE_URL=https://pos.pancake.vn/api/v1
PANCAKE_API_KEY=<jc-pancake-api-key-or-empty>
PANCAKE_ACCESS_TOKEN=<jc-pancake-access-token-or-empty>
PANCAKE_SHOP_ID=407330767
PANCAKE_PAGE_SIZE=200

# Ruza Thailand / ADS2 profile. Use the Ruza Meta account, not Vayxa.
ADS2_META_ACCESS_TOKEN=<ruza-ads2-meta-access-token>
ADS2_META_PAGE_ACCESS_TOKEN=<ruza-ads2-meta-page-access-token-or-empty>
ADS2_META_AD_ACCOUNT_ID=<ruza-ads2-meta-ad-account-id>
ADS2_META_PAGE_ID=<ruza-meta-page-id-or-empty>
ADS2_META_API_VERSION=v21.0
ADS2_PANCAKE_API_BASE_URL=https://pos.pancake.vn/api/v1
ADS2_PANCAKE_API_KEY=<ruza-pancake-api-key-or-empty>
ADS2_PANCAKE_ACCESS_TOKEN=<ruza-pancake-access-token-or-empty>
ADS2_PANCAKE_SHOP_ID=408116196
ADS2_PANCAKE_PAGE_SIZE=200

# Thai Duong live reconciliation and order status source for JC.
THAI_DUONG_API_BASE_URL=<thai-duong-api-base-url>
THAI_DUONG_API_TOKEN=<thai-duong-api-token>
THAI_DUONG_CUSTOMER_CODE=THA356
THAI_DUONG_AUTO_AUTH_ENABLED=0
THAI_DUONG_AUTH_EMAIL=<thai-duong-login-email-or-empty>
THAI_DUONG_AUTH_PASSWORD=<thai-duong-login-password-or-empty>
THAI_DUONG_AUTH_USERNAME=<thai-duong-login-username-or-empty>
THAI_DUONG_AUTH_REFRESH_TOKEN=<thai-duong-refresh-token-or-empty>
THAI_DUONG_AUTH_LOGIN_PATH=/api/v1/auth/login
THAI_DUONG_AUTH_REFRESH_PATH=/api/v1/auth/refresh

# Google Sheet Doi-soat used by JC P&L columns H/J.
RECONCILE_COD_SHEET_ENABLED=1
RECONCILE_COD_SHEET_MODE=oauth_user
RECONCILE_COD_SHEET_SPREADSHEET_ID=<google-sheet-id>
RECONCILE_COD_SHEET_GID=1159924290
RECONCILE_COD_SHEET_OAUTH_CLIENT_ID=<google-oauth-client-id>
RECONCILE_COD_SHEET_OAUTH_CLIENT_SECRET=<google-oauth-client-secret>
RECONCILE_COD_SHEET_OAUTH_REFRESH_TOKEN=<google-oauth-refresh-token>
RECONCILE_COD_SHEET_OAUTH_TOKEN_URI=https://oauth2.googleapis.com/token
RECONCILE_COD_PRODUCT_SHEET_ENABLED=1
RECONCILE_COD_PRODUCT_SHEET_NAME=Chi tiet SP COD

# Only needed when this machine itself deploys to Render. Do not send a live
# Render key in this file; create a new key on the target machine instead.
RENDER_API_KEY=<do-not-share-render-key>
